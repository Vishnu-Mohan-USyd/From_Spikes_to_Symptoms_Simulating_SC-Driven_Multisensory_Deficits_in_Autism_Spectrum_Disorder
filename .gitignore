# python bytecode
__pycache__/
*.pyc

# ---- runtime scratch — all regenerated by a measurement run; NOT part of the committed deliverable ----
# routec_net_io OUT_DIR (per-run intermediate)
out/
# per-GPU-lane partial JSONs (gates_main_g0.json, gate5_cre_g1.json, ...); canonical MERGED JSONs are kept
results/*_g[0-9].json
# per-lane stdout / lane-split bookkeeping / quick-look figs (house-style deliverables live in figures/)
results/parallel_lane_gpu*.out
results/parallel_summary.json
results/*.out
results/*.log
results/*.png
results/*.svg

